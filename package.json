{
  "name": "long-memory-studio",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/zod-types": "4.0.540",
    "express": "^5.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src && tsc",
    "tts": "node scripts/tts.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "srt": "node scripts/export-srt.mjs",
    "render": "node scripts/render.mjs",
    "upgrade": "remotion upgrade",
    "postinstall": "xattr -dr com.apple.quarantine node_modules 2>/dev/null || true",
    "app": "node app/build.mjs && node app/server.mjs",
    "app:watch": "node app/build.mjs --watch",
    "previews": "node scripts/previews.mjs",
    "lint:app": "tsc -p app/tsconfig.json"
  },
  "allowScripts": {
    "esbuild": false
  }
}
